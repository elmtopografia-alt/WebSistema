# ============================================
# SGT PROPOSTAS - CONFIGURAÇÃO DE AMBIENTE (Template)
# ============================================
# 1. Copie este arquivo para .env
# 2. Preencha com valores reais
# 3. NUNCA commite o arquivo .env real!
# ============================================

# Ambiente: development | production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_NAME=SGT Propostas

# ============================================
# BANCO DE DADOS
# ============================================
DB_HOST=demanda.mysql.dbaas.com.br
DB_PORT=3306
DB_DATABASE=demanda
DB_USERNAME=demanda
DB_PASSWORD=sua_senha_aqui
DB_CHARSET=utf8mb4

# ============================================
# BANCO DE DADOS (DEMO)
# ============================================
DB_DEMO_HOST=proposta.mysql.dbaas.com.br
DB_DEMO_DATABASE=proposta
DB_DEMO_USERNAME=proposta
DB_DEMO_PASS=sua_senha_aqui

# ============================================
# SEGURANÇA - GERE VALORES ÚNICOS!
# Use: openssl rand -base64 32
# ============================================
APP_KEY=sua_chave_secreta_aqui_minimo_32_caracteres
CSRF_TOKEN_SALT=outro_salt_unico_aqui

# ============================================
# SESSÃO
# ============================================
SESSION_LIFETIME=120
SESSION_SECURE=false        # true em produção (HTTPS)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict

# ============================================
# EMAIL
# ============================================
MAIL_HOST=email-ssl.com.br
MAIL_PORT=465
MAIL_USERNAME=admin.sgt@elmtopografia.com.br
MAIL_PASSWORD=sua_senha_aqui
MAIL_ENCRYPTION=ssl

# ============================================
# LIMITE DE REQUISIÇÕES (Rate Limiting)
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
