{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Abrir Sistema no Chrome",
            "url": "https://elmtopografia.com.br/Orcamento/",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug",
            "pathMapping": {
                "/Orcamento": "${workspaceFolder}"
            }
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Depurar Arquivo Atual",
            "url": "https://elmtopografia.com.br/Orcamento/${fileBasename}",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug",
            "pathMapping": {
                "/Orcamento": "${workspaceFolder}"
            }
        }
    ]
}