# CONFIGURAÇÃO E CREDENCIAIS
.env
.env.backup
.env.local
config/*.local.php

# DEPENDÊNCIAS
/vendor/
composer.lock
node_modules/

# LOGS E CACHE
/logs/
*.log
/cache/
/temp/
*.cache

# UPLOADS E ARQUIVOS DO USUÁRIO
/uploads/*
!/uploads/.gitkeep
/propostas_geradas/*
!/propostas_geradas/.gitkeep

# BACKUPS E LEGADOS
*.LEGADO
*.REMOVIDO
*.bak
*.old
*.backup

# IDE E SISTEMA
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# PHP
phpunit.xml
.phpunit.result.cache
.php_cs.cache

# NÃO IGNORAR (manter no repo)
!.env.example
!.gitkeep

# Desenvolvimento e Diagnóstico
debug_*.php
diagnostico_*.php
teste_*.php
run_updates.php
check_schema_columns.php
